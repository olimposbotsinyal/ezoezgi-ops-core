reports/alert_e2e_*/
reports/monitoring_stack/

# Metrics scrape performans kiyaslama ciktilari (scripts/ops/benchmark_metrics_scrape.py)
# -- ayni gerekce: makineye/ana bagli, tekrar calistirilabilir kiyaslama
# ciktisi, repoya birikmesin. Sayilar docs/ops/MONITORING_STACK_RUNBOOK.md'de
# ozetlenir; gerekirse `git add -f` ile belirli bir kosunun kaniti eklenebilir.
reports/metrics_perf_*/

# Go-live gate/kalibrasyon/sign-off/rollback ciktilari -- ayni gerekce:
# rutin, tekrar-uretilebilir kanit paketleri, repoya birikmesin. Gercek
# bir go-live kararinin kaniti olarak gerekiyorsa `git add -f` ile eklenebilir.
reports/go_live_gates_*/
reports/alert_calibration_*/
reports/observability_signoff_*/
reports/rollback_drill_*/
reports/gate_d_real_validation_*/
reports/drift_*/

# Esik degisikligi onay is akisi (proposal -> review -> apply -> rollback)
# ciktilari -- ayni gerekce: her calistirmada yeniden uretilebilir kanit
# paketleri, repoya birikmesin. GERCEK onayli bir esik degisikliginin
# KALICI kaydi zaten `infra/monitoring/baseline/approved_checksums_ledger.jsonl`
# (asagidaki NOT'a bkz. -- o dosya BURADA YOK, normal `git add` ile
# izlenir) ve `data/audit/audit.log.jsonl`'de (gitignored ama append-only)
# tutulur; bu yuzden tek bir apply/rollback raporunu ayrica commit'lemek
# GEREKMEZ. Genuinely onemli bir vakanin kaniti gerekiyorsa `git add -f`.
reports/threshold_proposals/
reports/threshold_reviews/
reports/threshold_apply_*/
reports/threshold_rollback_*/
reports/emergency_review_check_*/

# v1.2 PILOT ciktilari -- ayni gerekce: rutin/tekrar-uretilebilir. Bir
