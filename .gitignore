# Gunluk gateway smoke kanit paketleri -- rutin/otomatik uretilir, her
# gun birikip repoyu sisirmesin diye varsayilan olarak izlenmez. Belirli
# bir gunun ciktisi bir olayin kaniti olarak gerekiyorsa `git add -f`
# ile eklenebilir (bkz. reports/runtime_incident_*/ icin ayni desen).
reports/daily_smoke_*/
reports/incidents/

# E2E alert pipeline test/kanit ciktilari + izleme yigini PID/log kaydi --
# ayni gerekce: rutin/tekrarlanan test ciktisi, repoya birikmesin.
reports/alert_e2e_*/
reports/monitoring_stack/

# Metrics scrape performans kiyaslama ciktilari (scripts/ops/benchmark_metrics_scrape.py)
# -- ayni gerekce: makineye/ana bagli, tekrar calistirilabilir kiyaslama
# ciktisi, repoya birikmesin. Sayilar docs/ops/MONITORING_STACK_RUNBOOK.md'de
# ozetlenir; gerekirse `git add -f` ile belirli bir kosunun kaniti eklenebilir.
reports/metrics_perf_*/

# Go-live gate/kalibrasyon/sign-off/rollback ciktilari -- ayni gerekce:
# rutin, tekrar-uretilebilir kanit paketleri, repoya birikmesin. Gercek
# bir go-live kararinin kaniti olarak gerekiyorsa `git add -f` ile eklenebilir.
reports/go_live_gates_*/
reports/alert_calibration_*/
reports/observability_signoff_*/
reports/rollback_drill_*/
