# durumlarda `git add -f` ile arsivlenir.
reports/emergency_chain_trial_*/
reports/emergency_legitimacy_*/
reports/v1_2_pilot_*/
reports/pilot_promotion_*/
reports/pilot_flag_rollback_*/
reports/pilot_metrics_*/

