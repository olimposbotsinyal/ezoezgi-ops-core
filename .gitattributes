# EzoEzgi Ops -- satır sonu (line ending) normalizasyon politikası.
# bkz. docs/RUNBOOK.md "Line Ending Policy" bölümü.

* text=auto

*.py  text eol=lf
*.js  text eol=lf
*.ts  text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md  text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf
*.sh  text eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
